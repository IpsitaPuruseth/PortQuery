<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PortQueryBackend.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
	<security>
	  <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v2">
		<!-- Run at the caller's privilege level. Launch from a normal terminal
			 for network queries; launch from an elevated (Administrator) terminal
			 to enable PortQry Local Mode commands (-local, -wport, -wpid). -->
		<requestedExecutionLevel level="asInvoker" uiAccess="false" />
	  </requestedPrivileges>
	</security>
  </trustInfo>
</assembly>
