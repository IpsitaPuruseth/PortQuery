# PortQuery Backend Configuration Example
# Copy this file to .env and configure your settings

# Server Port
PORT=3001

# PortQry Executable Path
# Configure the path to your PortQryV2.exe installation
# If PortQry.exe is in your system PATH, you can leave it as just "PortQry.exe"
# Otherwise, specify the full path to the executable

# Examples - uncomment and edit the one that matches your installation:

# If PortQry is in your system PATH:
PORTQRY_PATH=PortQry.exe

# If installed in Program Files:
# PORTQRY_PATH=C:\\Program Files\\PortQryV2\\PortQry.exe

# If installed in System32:
# PORTQRY_PATH=C:\\Windows\\System32\\PortQry.exe

# If installed in a custom location:
# PORTQRY_PATH=C:\\Tools\\PortQryV2\\PortQry.exe
